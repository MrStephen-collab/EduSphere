# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_NAME=EduSphere
NEXT_PUBLIC_SUPPORT_EMAIL=support@edusphere.app

# PWA (optional)
# Set to true to enable the service worker while running `next dev`
NEXT_PUBLIC_ENABLE_PWA_DEV=false

# Payments (used from Phase 8)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# Email notifications (Phase 7)
# EMAIL_PROVIDER = "resend" | "brevo" | "log"  (default: log — prints to server console)
# EMAIL_FROM = "EduSphere <noreply@yourdomain.com>"
EMAIL_PROVIDER=log
EMAIL_FROM=EduSphere <noreply@edusphere.dev>
EMAIL_PROVIDER_API_KEY=

# Demo users (development only)
DEMO_USER_PASSWORD=Testing2026

# Video hosting (Mux)
# Without these, video uploads are reported as unavailable; documents, PDFs and
# audio still use the private Supabase bucket. Get the API token from
# Mux > Settings > Access Tokens, and a signing key from Mux > Settings > Signing Keys.
# MUX_SIGNING_PRIVATE_KEY is the base64 key Mux shows on the download page; the
# raw PEM also works.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
# Webhook signing secret, so Mux can prove an asset-ready event is genuine.
# Point the webhook at <app-url>/api/webhooks/video-host
MUX_WEBHOOK_SECRET=